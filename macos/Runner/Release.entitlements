<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  刻意不启用 App Sandbox（com.apple.security.app-sandbox）。

	  原因：本应用是自签分发的远程运维工具，工作方式与沙盒长期冲突——
	  要直读 ~/.ssh 下的私钥、要把文件下载到用户指定的任意目录、还要稳定
	  保存连接配置。而沙盒容器（~/Library/Containers/<bundle-id>/）会在
	  应用重装、代码签名变化等情况下被系统重置，用户看到的现象就是
	  「连接和分类全没了」。配置现已落在 ~/Library/Application Support/FastShell/，
	  脱离容器生命周期。

	  macOS 26 上 home-relative 例外（temporary-exception）对该目录已不生效，
	  故不保留沙盒外壳。本应用不从 App Store 分发，无需沙盒。

	  仅保留出站网络权限（SSH / SFTP 需要）。
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
